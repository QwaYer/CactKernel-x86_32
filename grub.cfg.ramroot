# Cact — загрузка с RAM userland (железо / USB):
#   multiboot2 kernel + модуль cctkfs (все *.cctk и /bin/* ELF в одном образе).
#   Init и шелл поднимаются из cctkfs без обязательного ext4 (см. nodisk mntfs).
# Для отдельного диска с данными загрузите kmod AHCI/NVMe как обычно.
#
# Сборка ISO с этим меню: make GRUB_CFG=grub.cfg.ramroot

set timeout=3
set default=0

menuentry "Cact (kernel + cctkfs, RAM userland)" {
    insmod all_video
    insmod vbe
    insmod vga
    insmod gfxterm
    set gfxpayload=1024x768x32
    multiboot2 /boot/kernel.bin
    module2   /boot/cctkfs.img cctkfs
    boot
}
